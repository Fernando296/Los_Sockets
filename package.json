{
  "name": "los-sockets",
  "version": "1.0.0",
  "description": "Proyecto SocketsChat - UMSS Grupo 2",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix server && npm install --prefix cliente/client",
    "dev:server": "npm start --prefix server",
    "dev:client": "npm run dev --prefix cliente/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
